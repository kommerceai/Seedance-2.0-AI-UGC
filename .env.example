# Enhancor API Configuration
# Get your API key from https://app.enhancor.ai/api-dashboard
# "Up to 65% off market price — the cheapest Seedance 2 Full Access API. Full face generation enabled."
ENHANCOR_API_KEY=your_api_key_here
ENHANCOR_API_URL=https://apireq.enhancor.ai/api/enhancor-ugc-full-access/v1

# fal.ai API Configuration (optional — only needed for --provider fal)
# Get your API key from https://fal.ai/dashboard/keys
# Install the client with: pip install fal-client
# Advantages: larger model catalog (Seedance, Kling, Runway, Veo, Minimax),
# built-in CDN upload via fal_client, native event streaming.
# Tradeoff: fal.ai's Seedance does NOT expose Enhancor's multi_frame mode;
# storyboards on fal always use chained first_n_last_frames rendering.
FAL_KEY=

# Override the fal.ai model slug used by the storyboard skill.
# Default: fal-ai/bytedance/seedance/v1/pro/image-to-video
FAL_MODEL=
# Override the keyframe model used for chained rendering.
# Default: fal-ai/bytedance/seedance/v1/pro/first-last-frame-to-video
FAL_MODEL_FIRST_LAST=

# Select which provider the storyboard skill uses by default.
# Options: enhancor (default) | fal
# Can also be overridden per-run via --provider on render_multiframe/render_chained.
STORYBOARD_PROVIDER=enhancor

# Webhook URL for provider callbacks (optional)
# If you expose localhost:8092 via ngrok or similar, set this to your public URL + /api/webhook
# Example: WEBHOOK_URL=https://your-tunnel.ngrok.io/api/webhook
# If not set, storyboard falls back to creating a fresh webhook.site token per run.
WEBHOOK_URL=

# Prompt Generation API (do not change unless self-hosting)
PROMPT_API_URL=https://gateway.sirioberati.com/.netlify/functions/generate-prompts

# Note: Image analysis is handled locally by Claude Code (no extra API key needed)
